--- a/include/flashinfer/fastdiv.cuh
+++ b/include/flashinfer/fastdiv.cuh
@@ -23,20 +23,21 @@ namespace flashinfer {
 // API-compatible wrapper around cuda::fast_mod_div<uint32_t>.
 // Preserves the default constructor, implicit conversions, and divmod()
 // method expected by existing call sites throughout the attention kernels.
+// Falls back to plain integer division when cuda::fast_mod_div is unavailable
+// (e.g. SM70 / Volta).
 struct uint_fastdiv {
-  __host__ __device__ uint_fastdiv() : impl_(1), d_(0) {}
+  __host__ __device__ uint_fastdiv() : d_(1) {}

-  __host__ uint_fastdiv(uint32_t d) : impl_(d ? d : 1), d_(d) {}
+  __host__ uint_fastdiv(uint32_t d) : d_(d ? d : 1) {}

   __host__ __device__ __forceinline__ operator unsigned int() const { return d_; }

   __host__ __device__ __forceinline__ void divmod(uint32_t n, uint32_t& q, uint32_t& r) const {
-    q = n / impl_;
+    q = n / d_;
     r = n - q * d_;
   }

  private:
-  cuda::fast_mod_div<uint32_t> impl_;
   uint32_t d_;
 };

diff --git a/include/flashinfer/sampling.cuh b/include/flashinfer/sampling.cuh
index ca260865..450c4ec1 100644
--- a/include/flashinfer/sampling.cuh
+++ b/include/flashinfer/sampling.cuh
@@ -37,7 +37,32 @@
 #include "utils.cuh"
 #include "vec_dtypes.cuh"

+struct MaxReduceOpF {
+  template <typename T>
+  __device__ __forceinline__ T operator()(const T& a, const T& b) const {
+    return a > b ? a : b;
+  }
+};
+
+struct MinReduceOpF {
+  template <typename T>
+  __device__ __forceinline__ T operator()(const T& a, const T& b) const {
+    return a < b ? a : b;
+  }
+};
+
+#ifndef __CUDA_ARCH__
+#define _FI_CUDA_ARCH 0
+#else
+#define _FI_CUDA_ARCH __CUDA_ARCH__
+#endif
+
+#if _FI_CUDA_ARCH >= 750
 using MaxReduceOp = cuda::maximum<>;
 using MinReduceOp = cuda::minimum<>;
+#else
+using MaxReduceOp = MaxReduceOpF;
+using MinReduceOp = MinReduceOpF;
+#endif

 namespace flashinfer {
